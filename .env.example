# Copy this file to .env and fill in your own keys.
# Do not put real keys in .env.example or commit .env.

# Bearer token for the Hindsight API
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Groq API key used by the food-waste assistant
GROQ_API_KEY=your_groq_api_key_here

# Memory bank name (bank id) for this canteen
HINDSIGHT_BANK_NAME=wastewise-canteen

# Hindsight Cloud address (use http://localhost:8888 only for a server on your own computer)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
